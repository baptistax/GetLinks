{
  "manifest_version": 3,
  "name": "getLinks",
  "version": "1.0",
  "description": "Finds and extracts links from open tabs based on a root URL.",
  "permissions": ["tabs", "downloads"],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html"
  }
}
