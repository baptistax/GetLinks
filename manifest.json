{
  "manifest_version": 3,
  "name": "GetLinks",
  "version": "1.0.0",
  "description": "Collects unique links from open tabs that belong to a site you choose.",
  "permissions": ["tabs", "clipboardWrite"],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "GetLinks",
    "default_popup": "popup.html"
  }
}
