{
  "manifest_version": 3,
  "name": "GetLinks",
  "version": "1.1.0",
  "description": "Find and review unique links for a site, copy selected URLs, and manage the matching open tabs. Everything stays local.",
  "permissions": ["tabs", "clipboardWrite", "storage", "favicon"],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "GetLinks",
    "default_popup": "popup.html"
  }
}
